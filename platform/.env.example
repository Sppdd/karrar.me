# Phase 0 provider credentials.
# Copy to .env and fill in. Never commit .env.
#
# You do not need all of these: run with --provider mock for a full dry run,
# or --provider kling to benchmark one model at a time.

# Google Veo 3.1 via the Gemini API. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kling. The API authenticates with a JWT signed from an access key / secret
# key pair; assemble the token yourself and put it here, so token minting stays
# out of the benchmark's latency measurements.
KLING_API_TOKEN=

# Runway developer API. https://dev.runwayml.com
RUNWAY_API_KEY=

# --- Payments (Wayl) -------------------------------------------------------
# https://wayl.io  |  API reference: https://api.thewayl.com/reference
WAYL_API_KEY=
# Sent to Wayl when creating a link; Wayl signs webhooks with it. Generate a
# long random value and treat it as a secret.
WAYL_WEBHOOK_SECRET=

# --- Database --------------------------------------------------------------
# Only needed for the concurrency tests; the rest of the suite uses PGlite.
DATABASE_URL=
